<mxCell id="gpio" value="&lt;b&gt;GPIO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;API / driver compartido&lt;br&gt;4 entradas + 2 salidas&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#ffffff;" vertex="1" parent="zephyr"><mxGeometry x="1005" y="60" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="api_note" value="Las flechas discontinuas indican dependencia de la API / driver; no secuencia temporal." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;text;fillColor=none;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="680" width="1190" height="30" as="geometry"/></mxCell>
<mxCell id="runtime" value="&lt;b&gt;Servicios comunes de ejecución de Zephyr&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Disponibles para Gateway Application y todos los módulos; no fijan hilos, prioridades ni contextos de ejecución.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#e4e8ec;" vertex="1" parent="zephyr"><mxGeometry x="25" y="185" width="1480" height="70" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Lectura:&lt;/b&gt; flecha continua = coordinación; agrupación / ramas sin punta = descomposición funcional; flecha discontinua = utiliza servicios.&lt;br&gt;Diagnostics, Configuration Management y Error Detection / Recovery colaboran con adquisición, procesamiento y comunicación/control.&lt;br&gt;Los módulos de procesamiento utilizan datos y servicios de los transportes; no acceden directamente a registros de periféricos." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;text;fillColor=none;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="1090" width="1520" height="85" as="geometry"/></mxCell>
<mxCell id="status" value="&lt;b&gt;PROPOSED · NOT IMPLEMENTED / NOT VALIDATED&lt;/b&gt; · Producto Rev. A completo; el alcance reducido de la PoC no lo sustituye.&lt;br&gt;Políticas de control / recuperación y protocolos de aplicación pendientes. No se prescribe un hilo por módulo." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;text;fillColor=none;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="1185" width="1520" height="55" as="geometry"/></mxCell>

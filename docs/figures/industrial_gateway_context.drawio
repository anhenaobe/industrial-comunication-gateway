<mxCell id="loads" value="&lt;b&gt;Actuadores y cargas externas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Activación / desactivación&lt;br&gt;2 DO low-side&lt;br&gt;24 V / 500 mA nominales por canal&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1235" y="555" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="tech" value="&lt;b&gt;Técnico de mantenimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Configuración · consulta de estado&lt;br&gt;Diagnóstico · mantenimiento&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="160" y="125" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="servicepc" value="&lt;b&gt;PC externo de mantenimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Medio de acceso y permisos&lt;br&gt;por especificar&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="125" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="adapter" value="&lt;b&gt;Adaptador externo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;18–30 VDC&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#f3f3f3;" vertex="1" parent="1"><mxGeometry x="440" y="635" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="cabinet" value="&lt;b&gt;Fuente de gabinete industrial&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;18–30 VDC&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#f3f3f3;" vertex="1" parent="1"><mxGeometry x="835" y="635" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="power_note" value="Dos fuentes posibles; pueden conectarse simultáneamente. Las flechas indican entrada de energía." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;text;fillColor=none;strokeColor=none;align=left;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="730" width="690" height="45" as="geometry"/></mxCell>
<mxCell id="cu" value="&lt;b&gt;Casos sintetizados para esta figura&lt;/b&gt;&lt;br&gt;&lt;b&gt;CU-01:&lt;/b&gt; adquirir, validar, procesar y transmitir datos industriales por Ethernet.&lt;br&gt;&lt;b&gt;CU-02:&lt;/b&gt; activar o desactivar las DO; condiciones de operación y autorización pendientes.&lt;br&gt;&lt;b&gt;CU-03:&lt;/b&gt; consultar estado y diagnóstico desde un PC externo." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;text;fillColor=none;strokeColor=none;align=left;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="795" width="1460" height="105" as="geometry"/></mxCell>
<mxCell id="notes" value="* Configuración / control sujetos a autorización; protocolo de aplicación por definir. El origen de las órdenes de DO permanece abierto.&lt;br&gt;Los CU sintetizados no sustituyen UC-01 a UC-06. Interrupción de red y retorno de alimentación son escenarios alternativos;&lt;br&gt;UC-06 mantiene la verificación integrada. Los dos roles de PC pueden compartir equipo. NOT IMPLEMENTED / NOT VALIDATED." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;text;fillColor=none;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="915" width="1460" height="90" as="geometry"/></mxCell>
<mxCell id="rs" value="2 × RS-485 half-duplex&lt;br&gt;Datos / intercambio bidireccional" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=14;strokeColor=#465463;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.16;entryX=0;entryY=0.12;" edge="1" parent="1" source="field" target="gateway"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>

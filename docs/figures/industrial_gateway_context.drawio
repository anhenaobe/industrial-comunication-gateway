<mxCell id="gateway" value="&lt;b&gt;Industrial Communication Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Industrial Data Acquisition · Processing&lt;br&gt;Ethernet Communication · Digital Output Control&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#eaf0f6;strokeWidth=2;fontSize=23;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="530" height="200" as="geometry"/></mxCell>
<mxCell id="field" value="&lt;b&gt;Equipos industriales y sensores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Datos de proceso y estados&lt;br&gt;Dispositivos externos según la aplicación&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#202830;strokeColor=#586675;strokeWidth=1.4;spacing=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="35" y="295" width="250" height="260" as="geometry"/></mxCell>

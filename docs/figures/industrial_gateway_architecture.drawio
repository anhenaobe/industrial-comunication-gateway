        <mxCell id="p_io" parent="power_zone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontSize=14;fontColor=#000000;spacing=8;" value="&lt;b&gt;ISOLATED DIGITAL INPUTS&lt;/b&gt;&lt;br&gt;2 × ISO1212 / 4 × 24 V inputs&lt;br&gt;Field-side Pload,max ≈ 0.264 W total&lt;br&gt;&lt;br&gt;&lt;b&gt;PROTECTED LOW-SIDE POWER SWITCHES&lt;/b&gt;&lt;br&gt;2 × BSP75N / 24 V nominal / 0.5 A per channel&lt;br&gt;&lt;b&gt;EXTERNAL switched-load capacity&lt;/b&gt;&lt;br&gt;12 W/channel / 24 W total&lt;br&gt;&lt;b&gt;INTERNAL conduction Ploss at 0.5 A&lt;/b&gt;&lt;br&gt;≈169 mW/channel / ≈338 mW total" vertex="1">
          <mxGeometry height="280" width="520" x="30" y="565" as="geometry" />
